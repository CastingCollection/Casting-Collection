# ── BACKEND (Express / server.js) — never sent to the browser ────────────────

# Supabase project URL (Project Settings → API → Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service_role / secret key (Project Settings → API → service_role secret)
# NEVER expose this key to the frontend/browser — it bypasses Row Level Security.
# This server uses it intentionally because it IS the trusted backend.
SUPABASE_SERVICE_KEY=your-service-role-key

PORT=3001

# ── FRONTEND (Vite / src/supabaseClient.js) — bundled into the browser code ──
# Vite only exposes env vars that start with VITE_, and only reads this file
# at dev-server start / build time — restart `npm run client` (or `npm run
# dev`) after creating or editing .env for these to take effect.
#
# Use the "anon" / "publishable" key here, NEVER the service_role key above —
# this one is intentionally public (it ends up in the browser bundle) and
# only lets a user do what Supabase Auth + your RLS policies allow.

# Same Supabase project URL as above (Project Settings → API → Project URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / publishable key (Project Settings → API → anon public key)
VITE_SUPABASE_ANON_KEY=your-anon-public-key
